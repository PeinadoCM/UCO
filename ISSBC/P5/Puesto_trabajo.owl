<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/puestoTrabajo#"
     xml:base="http://example.org/puestoTrabajo"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:esq_dom="http://example.org/esq_dom#">

    <owl:Ontology rdf:about="http://example.org/puestoTrabajo">
        <owl:imports rdf:resource="http://example.org/esq_dom"/>
    </owl:Ontology>

<!-- Instancias de Valoraciones -->
    <owl:NamedIndividual rdf:about="#Secretario">
        <rdf:type rdf:resource="http://example.org/esq_dom#Valoracion"/>
        <esq_dom:nombre rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Secretario</esq_dom:nombre>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Gerente">
        <rdf:type rdf:resource="http://example.org/esq_dom#Valoracion"/>
        <esq_dom:nombre rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gerente</esq_dom:nombre>
    </owl:NamedIndividual>

<!-- Instancias de Atributos -->
    <owl:NamedIndividual rdf:about="#Edad">
        <rdf:type rdf:resource="http://example.org/esq_dom#Atributo"/>
        <esq_dom:nombre rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Edad</esq_dom:nombre>
        <esq_dom:tipo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">int</esq_dom:tipo>
        <esq_dom:valorInicial rdf:datatype="http://www.w3.org/2001/XMLSchema#string">20</esq_dom:valorInicial>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Ingles">
        <rdf:type rdf:resource="http://example.org/esq_dom#Atributo"/>
        <esq_dom:nombre rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nivel de ingles</esq_dom:nombre>
        <esq_dom:tipo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">multiple</esq_dom:tipo>
        <esq_dom:posiblesValores rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ninguno</esq_dom:posiblesValores>
        <esq_dom:posiblesValores rdf:datatype="http://www.w3.org/2001/XMLSchema#string">B1</esq_dom:posiblesValores>
        <esq_dom:posiblesValores rdf:datatype="http://www.w3.org/2001/XMLSchema#string">B2</esq_dom:posiblesValores>
        <esq_dom:posiblesValores rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C1</esq_dom:posiblesValores>
        <esq_dom:posiblesValores rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C2</esq_dom:posiblesValores>
        <esq_dom:valorInicial rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ninguno</esq_dom:valorInicial>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Titulacion">
        <rdf:type rdf:resource="http://example.org/esq_dom#Atributo"/>
        <esq_dom:nombre rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mayor titulación académica</esq_dom:nombre>
        <esq_dom:tipo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">multiple</esq_dom:tipo>
        <esq_dom:posiblesValores rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ESO</esq_dom:posiblesValores>
        <esq_dom:posiblesValores rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bachiller</esq_dom:posiblesValores>
        <esq_dom:posiblesValores rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Grado Medio</esq_dom:posiblesValores>
        <esq_dom:posiblesValores rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Grado Superior</esq_dom:posiblesValores>
        <esq_dom:posiblesValores rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Grado Universitario</esq_dom:posiblesValores>
        <esq_dom:posiblesValores rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Master</esq_dom:posiblesValores>
        <esq_dom:valorInicial rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ESO</esq_dom:valorInicial>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Experiencia">
        <rdf:type rdf:resource="http://example.org/esq_dom#Atributo"/>
        <esq_dom:nombre rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Años de experiencia</esq_dom:nombre>
        <esq_dom:tipo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">int</esq_dom:tipo>
        <esq_dom:valorInicial rdf:datatype="http://www.w3.org/2001/XMLSchema#string">3</esq_dom:valorInicial>
    </owl:NamedIndividual>

