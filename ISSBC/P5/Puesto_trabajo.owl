        <esq_dom:tipoResultado rdf:datatype="http://www.w3.org/2001/XMLSchema#string">año</esq_dom:tipoResultado>
        <esq_dom:puntuacion rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</esq_dom:puntuacion>
        <esq_dom:valor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[18,50]</esq_dom:valor>
        <esq_dom:obligatoria rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</esq_dom:obligatoria>
        <esq_dom:valoracion rdf:resource="#Secretario"/>
