    <!-- http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Pizza -->

    <owl:Class rdf:about="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Pizza">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Self_Standing_Entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#has_base"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Pizza_base"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Pizza_base"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Pizza_topping"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Pizza_Con_Queso -->

    <owl:Class rdf:about="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Pizza_Con_Queso">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#has_topping"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Cheese_topping"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Pizza"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Pizza_Margarita -->

