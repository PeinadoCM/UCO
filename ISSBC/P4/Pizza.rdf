<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5/"
     xml:base="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#has_base -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#has_base">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#has_part"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Pizza_base"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#has_fat_content -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#has_fat_content">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Pizza_topping"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Fat_content"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#has_part -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#has_part">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Pizza"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#has_spiciness -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#has_spiciness">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Pizza_topping"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Spiciness"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#has_topping -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#has_topping">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#has_part"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Pizza_topping"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Anchoa -->

    <owl:Class rdf:about="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Anchoa">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Fish_topping"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Atun -->

    <owl:Class rdf:about="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Atun">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Fish_topping"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Cebolla -->

    <owl:Class rdf:about="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Cebolla">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Vegetable_topping"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Champiñon -->

    <owl:Class rdf:about="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Champiñon">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Vegetable_topping"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Cheese_topping -->

    <owl:Class rdf:about="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Cheese_topping">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Pizza_topping"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#has_fat_content"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#high_fat"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#has_spiciness"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#bland"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Domain_entity -->

    <owl:Class rdf:about="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Domain_entity"/>
    


    <!-- http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Fat_content -->

    <owl:Class rdf:about="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Fat_content">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#ValuePartition"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Fish_topping -->

    <owl:Class rdf:about="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Fish_topping">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Pizza_topping"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#has_fat_content"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#low_fat"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#has_spiciness"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#bland"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#High_fat_topping -->

    <owl:Class rdf:about="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#High_fat_topping">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Pizza_topping"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Meat_topping -->

    <owl:Class rdf:about="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Meat_topping">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/usuario/ontologies/2025/3/untitled-ontology-5#Pizza_topping"/>
